<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicNext" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.MN.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.MN.Button.Outlined">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>
